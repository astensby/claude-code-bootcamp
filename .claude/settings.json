{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run dev *)",
      "Bash(npm ci)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/toolkit/hooks/stop-run-tests.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
